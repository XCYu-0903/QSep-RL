{
    "model": {
        "lan_embed_dim": 1024,
        "depths": [1, 1, 1, 1],
        "embed_dim": 128,
        "encoder_embed_dim": 128,
        "phase": false,
        "spec_factor": 8,
        "d_attn": 640,
        "n_masker_layer": 3,
        "conv": false
    },
    "train_data": {
        "input_dir": "./data/audioset",
        "metadata_json": "./metadata/audiocaps_train.json",
        "dset": "train",
        "sr": 32000,
        "resample_rate": 48000,
        "ontology_path": "path/to/ontology.json",
        "use_ontology_filter": false
    },
    "val_data": {
        "input_dir": "./data/audioset",
        "metadata_json": "./metadata/audiocaps_val.json",
        "dset": "val",
        "sr": 32000,
        "resample_rate": 48000,
        "ontology_path": "path/to/ontology.json",
        "use_ontology_filter": false
    },
    "clap_path": "path/to/music_audioset_epoch_15_esc_90.14.pt",
    "lora": true,
    "lora_rank": 16,
    "use_rl": true,
    "ppo_epochs": 3,
    "sup_weight": 1.0,
    "rl_weight": 0.1,
    "rl_clip_range": 0.2,
    "rl_entropy_coef": 0.1,
    "rl_kl_coef": 0.01,
    "rl_use_grpo": true,
    "rl_beta_kappa": 15.0,
    "rl_negative_weight": 1.0,
    "rl_baseline_momentum": 0.92,
    "nfft": 1024,
    "epochs": 150,
    "batch_size": 128,
    "eval_batch_size": 128,
    "n_workers": 8,
    "pin_memory": false,
    "lr": 2e-4,
    "min_lr": 5e-6,
    "lr_decay_factor": 0.3,
    "lr_patience": 5,
    "beta1": 0.9,
    "beta2": 0.999,
    "weight_decay": 1e-2,
    "freeze_lora": false,
    "freeze_decoder": false,
    "max_grad_norm": 1.0,
    "validate_at_start": true
}
